{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimoire Maker",
  "version": "../package.json",
  "identifier": "app.grimoiremaker.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grimoire Maker",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "JFEspanolito",
    "copyright": "©2026 JFEspanolito",
    "shortDescription": "Grimoire Maker",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Spanish"
        ],
        "installerHooks": "nsis/hooks.nsh",
        "template": "nsis/installer.nsi"
      }
    }
  }
}
