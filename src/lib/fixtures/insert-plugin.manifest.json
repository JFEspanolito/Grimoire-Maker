{
  "schemaVersion": 1,
  "sdkVersion": 2,
  "id": "custom.encounter-tools",
  "name": "Encounter Tools",
  "version": "1.0.0",
  "author": "Test Author",
  "description": "Buttons that insert encounter tables.",
  "main": "dist/index.js",
  "permissions": ["editor:insert"],
  "contributions": {
    "toolbar": [
      {
        "id": "insert-1",
        "type": "button",
        "label": "Encounter table",
        "action": { "type": "insertMarkdown", "markdown": "## Encounter\n\n| d6 | Result |\n| --- | --- |\n| 1 | Goblins |\n" }
      }
    ]
  }
}
