{
  "schemaVersion": 1,
  "sdkVersion": 2,
  "id": "builtin.zoom",
  "name": "Zoom",
  "version": "2.0.0",
  "author": "Grimoire Maker",
  "description": "Editor and preview zoom selectors with Ctrl+wheel stepping.",
  "main": "dist/index.js",
  "permissions": ["editor:zoom:read", "editor:zoom:write"],
  "contributions": {
    "toolbar": [
      {
        "id": "zoom-editor", "type": "select", "label": "Zoom", "bind": "zoom", "when": "markdown",
        "options": [
          { "value": "0.25", "label": "25%" }, { "value": "0.5", "label": "50%" }, { "value": "0.75", "label": "75%" },
          { "value": "1", "label": "100%" }, { "value": "1.25", "label": "125%" }, { "value": "1.5", "label": "150%" },
          { "value": "1.75", "label": "175%" }, { "value": "2", "label": "200%" }, { "value": "2.5", "label": "250%" },
          { "value": "3", "label": "300%" }
        ]
      },
      {
        "id": "zoom-preview", "type": "select", "label": "Zoom", "bind": "surfaceZoom", "slot": "preview",
        "options": [
          { "value": "0.4", "label": "40%" }, { "value": "0.5", "label": "50%" }, { "value": "0.6", "label": "60%" },
          { "value": "0.75", "label": "75%" }, { "value": "1", "label": "100%" }
        ]
      }
    ],
    "behaviors": [
      {
        "id": "zoom-wheel", "type": "wheelZoom",
        "editorSteps": [25, 50, 75, 100, 125, 150, 175, 200, 250, 300],
        "previewSteps": [40, 50, 60, 75, 100]
      }
    ]
  }
}
