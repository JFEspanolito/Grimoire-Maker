{
  "schemaVersion": 1,
  "sdkVersion": 2,
  "id": "builtin.pixel-ruler",
  "name": "Pixel Ruler",
  "version": "2.0.0",
  "author": "Grimoire Maker",
  "description": "Page ruler with margin and bleed boxes and draggable guides.",
  "main": "dist/index.js",
  "permissions": ["editor:geometry:read", "editor:guides:read", "editor:guides:write"],
  "contributions": {
    "toolbar": [
      { "id": "ruler-toggle", "type": "toggle", "label": "Ruler", "bind": "rulerVisible", "when": "markdown" }
    ],
    "overlays": [{ "id": "ruler", "type": "ruler" }],
    "tools": [{ "id": "guides", "type": "guidesMenu", "label": "Guides" }]
  }
}
